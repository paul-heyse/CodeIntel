# CodeIntel Build Configuration
# ==============================
# Copy this file to codeintel.build.toml to customize build parameters.
# All values shown are defaults.

# ---------------------------------------------------------------------------
# Analytics Configuration
# ---------------------------------------------------------------------------

[analytics.hotspots]
# Maximum number of git commits to analyze for hotspot detection
max_commits = 2000

[analytics.function_history]
# Maximum days of git history to analyze
max_history_days = 365
# Minimum lines in a function to include in history
min_lines_threshold = 1
# Default branch for git operations
default_branch = "HEAD"

[analytics.history_timeseries]
# Days back to compute timeseries
days_back = 90
# Bucket size in days
bucket_days = 7

[analytics.profiles]
# Include CODEOWNERS data in profiles
include_ownership = true
# Compute trend data (previous values)
compute_trends = true

[analytics.subsystems]
# Minimum modules to form a subsystem
min_modules_per_subsystem = 2
# Maximum subsystems to detect
max_subsystems = 50

[analytics.semantic_roles]
# Minimum confidence for role assignment
min_confidence = 0.7

[analytics.coverage_functions]
# Minimum coverage to include in reports
min_coverage_threshold = 0.0

[analytics.data_models]
# Include private/internal data models
include_private = false

[analytics.graph_metrics]
# Compute extended graph metrics (pagerank, etc.)
enable_extended_metrics = true

[analytics.risk_factors]
# Weights for risk score computation
[analytics.risk_factors.weights]
complexity = 0.3
coverage = 0.2
churn = 0.2
coupling = 0.15
age = 0.15

[analytics.external_deps]
# Include stdlib in external dependencies
include_stdlib = false

[analytics.entrypoints]
# Detect HTTP endpoints
detect_http = true
# Detect CLI commands
detect_cli = true
# Detect gRPC services
detect_grpc = false

# ---------------------------------------------------------------------------
# Ingestion Configuration
# ---------------------------------------------------------------------------

[ingestion]
# Skip files with no content
skip_empty_files = true

[ingestion.scip]
# Patterns to include in SCIP indexing
include_patterns = ["src/**/*.py"]
# Patterns to exclude from SCIP indexing
exclude_patterns = ["**/test_*.py", "**/*_test.py"]

[ingestion.typing]
# Run all type checkers (pyright, pyrefly, ruff)
run_all_checkers = true

[ingestion.coverage]
# Default coverage file location
coverage_file = ".coverage"

# ---------------------------------------------------------------------------
# Graphs Configuration
# ---------------------------------------------------------------------------

[graphs]
# Enable GPU acceleration for graph operations (if available)
use_gpu = false

[graphs.call_graph]
# Include indirect calls in call graph
include_indirect = true

[graphs.import_graph]
# Include type-only imports
include_type_imports = true

# ---------------------------------------------------------------------------
# Hamilton Configuration
# ---------------------------------------------------------------------------

[hamilton]
# Graph data source selection: compute | existing | empty
graph_backend = "compute"

# ---------------------------------------------------------------------------
# Export Configuration
# ---------------------------------------------------------------------------

[export]
# Validate exports against schemas
validate_exports = true
# Export formats to produce
formats = ["jsonl", "parquet"]
