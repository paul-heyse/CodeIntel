{
  "pack_id": "wire.python.typer.cli",
  "entry_kind": "cli",
  "framework": "typer",
  "description": "Discover Typer apps and @app.command wiring (best-effort; multi-file app patterns exist).",
  "stages": [
    {
      "engine": "rpygrep",
      "preset": "rg.default_interactive",
      "pattern_group_file": "rpygrep/patterns/typer_cli.json",
      "purpose": "candidate_files"
    },
    {
      "engine": "ast_grep",
      "rules_file": "ast_grep/python/typer.yaml",
      "rule_ids": [
        "py.typer.app.assign",
        "py.typer.command.decorator",
        "py.typer.run.call"
      ],
      "run_on": "candidate_files"
    }
  ],
  "postprocess": [
    {
      "op": "python.derive_handler_from_enclosing_def",
      "when_rule_ids": [
        "py.typer.command.decorator"
      ],
      "strategies": [
        "tree_sitter_enclosing_decorated_definition",
        "heuristic_next_def"
      ]
    }
  ],
  "emit": {
    "entry_key_template": "TYPER:{rule_id}",
    "target_symbol_hint_capture": "HANDLER_DERIVED",
    "hook_span_capture": "MATCH_NODE"
  }
}