{
  "pack_id": "wire.python.flask.routes",
  "entry_kind": "route",
  "framework": "flask",
  "description": "Discover Flask route registrations (decorators + add_url_rule).",
  "stages": [
    {
      "engine": "rpygrep",
      "preset": "rg.default_interactive",
      "pattern_group_file": "rpygrep/patterns/flask_routes.json",
      "purpose": "candidate_files_and_spans"
    },
    {
      "engine": "ast_grep",
      "rules_file": "ast_grep/python/flask.yaml",
      "rule_ids": [
        "py.flask.route.decorator",
        "py.flask.add_url_rule.call"
      ],
      "run_on": "candidate_files"
    },
    {
      "engine": "tree_sitter",
      "query_file": "tree_sitter/python/wiring_flask.scm",
      "mode": "matches",
      "fallback": true
    }
  ],
  "postprocess": [
    {
      "op": "python.unquote_capture",
      "capture_names": [
        "PATH",
        "path",
        "path2"
      ]
    },
    {
      "op": "python.derive_handler_from_enclosing_def",
      "when_rule_ids": [
        "py.flask.route.decorator"
      ],
      "strategies": [
        "tree_sitter_enclosing_decorated_definition",
        "heuristic_next_def"
      ]
    }
  ],
  "emit": {
    "entry_key_template": "ROUTE {PATH_unquoted}",
    "target_symbol_hint_capture": "HANDLER_DERIVED",
    "hook_span_capture": "MATCH_NODE",
    "extra_fields": {
      "registrar_capture": "APP"
    }
  }
}