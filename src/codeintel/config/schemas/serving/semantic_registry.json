{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeIntel semantic_registry.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "views"],
  "properties": {
    "version": { "type": "string" },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "table_key", "entity", "grain"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["table", "view"], "default": "view" },
          "table_key": { "type": "string" },
          "entity": { "type": "string" },
          "grain": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "primary_key": { "type": "array", "items": { "type": "string" }, "default": [] },
          "columns": { "type": "array", "items": { "type": "string" }, "default": [] },
          "joins": { "type": "array", "default": [] },
          "defaults": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "limit": { "type": "integer", "minimum": 0, "default": 200 },
              "order_by": { "type": "array", "items": { "type": "string" }, "default": [] }
            }
          },
          "sensitivity": { "type": "string", "default": "internal" }
        }
      }
    }
  }
}
