{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeIntel snapshot_manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "repo",
    "commit",
    "published_at",
    "db_path",
    "semantic_registry_path",
    "schema_manifest_path",
    "buildspec_path",
    "semantic_layer_version"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "repo": { "type": "string" },
    "commit": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" },
    "db_path": { "type": "string" },
    "semantic_registry_path": { "type": "string" },
    "schema_manifest_path": { "type": "string" },
    "buildspec_path": { "type": "string" },
    "semantic_layer_version": { "type": "string" }
  }
}
