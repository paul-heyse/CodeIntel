{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeIntel schema_manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tables"],
  "properties": {
    "version": { "const": "v2" },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "name", "columns"],
        "properties": {
          "schema": { "type": "string" },
          "name": { "type": "string" },
          "table_key": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "primary_key": { "type": "array", "items": { "type": "string" }, "default": [] },
          "indexes": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "columns"],
              "properties": {
                "name": { "type": "string" },
                "columns": { "type": "array", "items": { "type": "string" } },
                "unique": { "type": "boolean", "default": false }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "nullable": { "type": "boolean", "default": true },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "schema_hash": { "type": "string" },
          "derivation_kind": { "type": "string" },
          "derivation_source": { "type": "string" },
          "inference_status": { "type": ["string", "null"] },
          "inference_error": { "type": ["string", "null"] }
        }
      }
    },
    "views": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "name", "columns"],
        "properties": {
          "schema": { "type": "string" },
          "name": { "type": "string" },
          "table_key": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "primary_key": { "type": "array", "items": { "type": "string" }, "default": [] },
          "indexes": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "columns"],
              "properties": {
                "name": { "type": "string" },
                "columns": { "type": "array", "items": { "type": "string" } },
                "unique": { "type": "boolean", "default": false }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "nullable": { "type": "boolean", "default": true },
                "description": { "type": ["string", "null"] }
              }
            }
          },
          "schema_hash": { "type": "string" },
          "derivation_kind": { "type": "string" },
          "derivation_source": { "type": "string" },
          "inference_status": { "type": ["string", "null"] },
          "inference_error": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "filename"],
        "properties": {
          "kind": { "type": "string" },
          "filename": { "type": "string" },
          "table_key": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "artifact_provenance": {
      "type": "object",
      "default": {},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_table_keys", "source_schema_hashes"],
        "properties": {
          "source_table_keys": { "type": "array", "items": { "type": "string" } },
          "source_schema_hashes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
